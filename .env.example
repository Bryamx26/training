# Copie ce fichier en .env à la racine du projet, puis complète les valeurs.
# Il est lu par docker compose (docker-compose.yml en dev, docker-compose.prod.yml
# en production). La base SQLite se configure à part, dans database/.env :
#   DATABASE_URL="file:./sport.db"

# ============================================================================
# Commun (dev et production)
# ============================================================================

# Secret de signature des jetons de session (obligatoire). Génère-le avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Le changer déconnecte tous les utilisateurs.
JWT_SECRET=

# Client ID OAuth 2.0 Google (console.cloud.google.com > APIs & Services > Identifiants
# > Créer des identifiants > ID client OAuth > Application Web). Vide : bouton
# Google masqué. Dans "Origines JavaScript autorisées", ajoute :
#   http://localhost:5174 en dev, et la valeur de FRONT_URL en production.
GOOGLE_CLIENT_ID=

# Compte administrateur (gère les utilisateurs, valide les demandes de compte coach).
# Au démarrage : si ADMIN_EMAIL correspond à un compte existant, il est promu ADMIN
# (son mot de passe ne change pas) ; sinon le compte est créé avec ADMIN_PASSWORD
# (8 caractères minimum). Une fois le compte créé, ADMIN_PASSWORD peut être retiré.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ============================================================================
# Production uniquement (docker-compose.prod.yml)
# ============================================================================

# Adresses publiques du front et de l'API (obligatoires), avec https:// et sans
# "/" final. FRONT_URL est la seule origine autorisée par l'API (CORS).
# API_URL est écrite dans le JavaScript compilé : la changer impose de
# reconstruire le front (docker compose -f docker-compose.prod.yml up -d --build).
FRONT_URL=https://sport-track.mon-domaine.fr
API_URL=https://api-sport-track.mon-domaine.fr

# Cookie de session réservé à HTTPS. Laisser à true ; false seulement pour un
# test en HTTP simple (sinon la connexion échoue).
# COOKIE_SECURE=true

# Ports de la machine (127.0.0.1) vers lesquels pointe le reverse proxy HTTPS :
#   FRONT_URL -> WEB_PORT, API_URL -> API_PORT
# WEB_PORT=80
# API_PORT=4000

# Tentatives de connexion / inscriptions publiques autorisées par IP et par 15 minutes.
# AUTH_RATE_LIMIT=10
