# Copie ce fichier en .env à la racine du projet, puis complète les valeurs.

# Secret de signature des jetons de session (obligatoire). Génère-le avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Le changer déconnecte tous les utilisateurs.
JWT_SECRET=

# Client ID OAuth 2.0 Google (console.cloud.google.com > APIs & Services > Identifiants
# > Créer des identifiants > ID client OAuth > Application Web).
# Ajoute l'adresse du front dans "Origines JavaScript autorisées" :
# http://localhost:5174 en développement (docker-compose.yml), ton domaine en production.
GOOGLE_CLIENT_ID=

# Compte administrateur (gère les utilisateurs, valide les demandes de compte coach).
# Au démarrage : si ADMIN_EMAIL correspond à un compte existant, il est promu ADMIN
# (son mot de passe ne change pas) ; sinon le compte est créé avec ADMIN_PASSWORD
# (8 caractères minimum). Une fois le compte créé, ADMIN_PASSWORD peut être retiré.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Adresses publiques en production (docker-compose.prod.yml), sans "/" final.
# FRONT_URL est autorisée par l'API (CORS) ; API_URL est compilée dans le front.
# Ajoute aussi FRONT_URL dans les "Origines JavaScript autorisées" de Google.
FRONT_URL=https://sport-track.mon-domaine.fr
API_URL=https://api-sport-track.mon-domaine.fr

# --- Optionnel ---

# Cookie de session réservé à HTTPS (true par défaut en production).
# COOKIE_SECURE=true

# Ports locaux de la production, vers lesquels pointe le reverse proxy HTTPS.
# WEB_PORT=80
# API_PORT=4000

# Tentatives de connexion / inscriptions publiques autorisées par IP et par 15 minutes.
# AUTH_RATE_LIMIT=10

# Origines externes autorisées à appeler l'API (séparées par des virgules).
# En production, docker-compose.prod.yml la remplit avec FRONT_URL.
# CORS_ORIGIN=
