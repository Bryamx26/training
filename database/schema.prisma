// Schéma basé sur base_de_donnees_sport_db.excalidraw
// Entités : Profil, Circuit, Exercice (+ tables de liaison Muscle / Participant)

generator client {
  provider = "prisma-client-js"
  // généré dans node_modules de l'api (dossier voisin) puisque la base
  // de données et l'api vivent dans des dossiers différents
  output   = "../api/node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  COACH
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
}

enum TypeCircuit {
  FORCE
  ENDURANCE
  HYPERTROPHIE
  FIGURE
}

model Profil {
  id           Int      @id @default(autoincrement())
  nom          String
  prenom       String
  mail         String   @unique
  motDePasse   String
  poids        Float?
  taille       Float?
  age          Int?
  blessures    String?
  role         Role     @default(USER)
  // Inscription publique en tant que coach : le compte reste sportif (USER)
  // tant qu'un admin n'a pas validé la demande.
  demandeCoach Boolean  @default(false)
  // Date d'acceptation des CGU et de la politique de confidentialité (preuve
  // du consentement, RGPD art. 7). Null : compte créé par un coach ou un admin.
  cguAccepteesLe DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  circuits       Circuit[]            @relation("CircuitAuteur")
  participations CircuitParticipant[]
  exerciceNotes  ExerciceNote[]

  // Abonnements : un coach a des abonnés, un sportif suit des coachs.
  abonnes        CoachSubscription[] @relation("CoachAbonnes")
  coachsSuivis   CoachSubscription[] @relation("SportifCoachs")

  templates      CircuitTemplate[]
  notifications  Notification[]
  realisations   Realisation[]

  @@map("profils")
}

model Circuit {
  id        Int         @id @default(autoincrement())
  nom       String
  note      Float?
  niveau    String?
  type      TypeCircuit
  date      DateTime
  createdAt DateTime    @default(now())

  auteurId Int
  auteur   Profil @relation("CircuitAuteur", fields: [auteurId], references: [id], onDelete: Cascade)

  personnes    CircuitParticipant[]
  exercices    Exercice[]
  realisations Realisation[]

  @@map("circuits")
}

// Abonnement d'un sportif à un coach. Un coach ne peut ajouter à ses séances
// que ses abonnés actifs. Un désabonnement passe le statut à CANCELLED sans
// supprimer la ligne ni les participations passées (historique conservé).
model CoachSubscription {
  id        Int                @id @default(autoincrement())
  status    SubscriptionStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  coachId   Int
  coach     Profil @relation("CoachAbonnes", fields: [coachId], references: [id], onDelete: Cascade)
  athleteId Int
  athlete   Profil @relation("SportifCoachs", fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([coachId, athleteId])
  @@index([athleteId])
  @@map("coach_subscriptions")
}

model CircuitParticipant {
  id        Int    @id @default(autoincrement())
  circuitId Int
  profilId  Int
  circuit   Circuit @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  profil    Profil  @relation(fields: [profilId], references: [id], onDelete: Cascade)

  @@unique([circuitId, profilId])
  @@map("circuit_participants")
}

model Exercice {
  id           Int     @id @default(autoincrement())
  exercice     String
  description  String?
  consignes    String?
  objectif     String?
  series       Int?
  nbRep        Int?
  duree        Int?
  tempsDeRepos Int?
  tempo        String?
  lest         Float?
  amplitude    String?
  url          String?
  ordre        Int     @default(0)

  circuitId Int
  circuit   Circuit @relation(fields: [circuitId], references: [id], onDelete: Cascade)

  muscles         ExerciceMuscle[]
  notes           ExerciceNote[]
  seriesRealisees SerieRealisee[]

  @@map("exercices")
}

// Évaluation du coach pour un exercice, indépendante par participant :
// une séance à plusieurs sportifs peut être notée différemment pour chacun.
model ExerciceNote {
  id          Int      @id @default(autoincrement())
  note        Float?
  commentaire String?
  updatedAt   DateTime @updatedAt

  exerciceId Int
  exercice   Exercice @relation(fields: [exerciceId], references: [id], onDelete: Cascade)

  profilId Int
  profil   Profil @relation(fields: [profilId], references: [id], onDelete: Cascade)

  @@unique([exerciceId, profilId])
  @@map("exercice_notes")
}

// Modèle de séance réutilisable, propre à un coach. Il ne contient que le
// contenu de la séance (nom, type, difficulté, exercices) : ni date ni
// participants. Les séances créées depuis un template en COPIENT le contenu,
// donc modifier le template ne change pas les séances existantes.
model CircuitTemplate {
  id        Int          @id @default(autoincrement())
  nom       String
  niveau    String?
  type      TypeCircuit?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  coachId Int
  coach   Profil @relation(fields: [coachId], references: [id], onDelete: Cascade)

  exercices TemplateExercice[]

  @@index([coachId])
  @@map("circuit_templates")
}

// Exercice d'un template : mêmes paramètres qu'un exercice de séance, sans notes.
model TemplateExercice {
  id           Int     @id @default(autoincrement())
  exercice     String
  description  String?
  consignes    String?
  objectif     String?
  series       Int?
  nbRep        Int?
  duree        Int?
  tempsDeRepos Int?
  tempo        String?
  lest         Float?
  amplitude    String?
  url          String?
  ordre        Int     @default(0)

  templateId Int
  template   CircuitTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("template_exercices")
}

model Muscle {
  id   Int    @id @default(autoincrement())
  nom  String @unique

  exercices ExerciceMuscle[]

  @@map("muscles")
}

model ExerciceMuscle {
  id         Int      @id @default(autoincrement())
  exerciceId Int
  muscleId   Int
  exercice   Exercice @relation(fields: [exerciceId], references: [id], onDelete: Cascade)
  muscle     Muscle   @relation(fields: [muscleId], references: [id], onDelete: Cascade)

  @@unique([exerciceId, muscleId])
  @@map("exercice_muscles")
}

// Notification affichée dans l'application (cloche de l'accueil).
// `lien` est une route du front (ex. "/seances/12").
model Notification {
  id        Int      @id @default(autoincrement())
  type      String
  message   String
  lien      String?
  lu        Boolean  @default(false)
  createdAt DateTime @default(now())

  profilId Int
  profil   Profil @relation(fields: [profilId], references: [id], onDelete: Cascade)

  @@index([profilId, lu])
  @@map("notifications")
}

// Ce que le sportif a RÉELLEMENT fait lors d'une séance (saisi dans le lecteur) :
// détail de chaque série. Seul le coach note une séance. Une seule réalisation
// par participant et par séance : la relancer remplace la précédente.
model Realisation {
  id          Int      @id @default(autoincrement())
  commentaire String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  circuitId Int
  circuit   Circuit @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  profilId  Int
  profil    Profil  @relation(fields: [profilId], references: [id], onDelete: Cascade)

  series SerieRealisee[]

  @@unique([circuitId, profilId])
  @@index([profilId])
  @@map("realisations")
}

model SerieRealisee {
  id    Int    @id @default(autoincrement())
  serie Int
  reps  Int?
  lest  Float?
  duree Int?

  realisationId Int
  realisation   Realisation @relation(fields: [realisationId], references: [id], onDelete: Cascade)
  exerciceId    Int
  exercice      Exercice    @relation(fields: [exerciceId], references: [id], onDelete: Cascade)

  @@index([exerciceId])
  @@map("series_realisees")
}
